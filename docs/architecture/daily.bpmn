      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f11" bpmnElement="f11">
        <di:waypoint x="960" y="245"/>
        <di:waypoint x="1030" y="245"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f12" bpmnElement="f12">
        <di:waypoint x="1270" y="245"/>
        <di:waypoint x="1395" y="245"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_f13" bpmnElement="f13">
        <di:waypoint x="1239" y="308"/>
        <di:waypoint x="1239" y="511"/>
        <di:waypoint x="1370" y="511"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_m1" bpmnElement="m1">
        <di:waypoint x="320" y="200"/>
        <di:waypoint x="320" y="95"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_m2" bpmnElement="m2">
        <di:waypoint x="380" y="95"/>
