      <bpmndi:BPMNEdge id="Edge_m4" bpmnElement="m4">
        <di:waypoint x="1190" y="95"/>
        <di:waypoint x="1190" y="200"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
